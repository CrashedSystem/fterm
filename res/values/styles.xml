<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- targetSdk 35+ draws edge to edge by default; the status bar and navigation bar
             colours below are honoured only on older releases and are kept as a fallback. -->
        <item name="android:statusBarColor">#FF2B2B2B</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>

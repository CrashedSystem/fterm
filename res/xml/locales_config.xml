<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages this app ships, for Android 13+'s per-app language picker.

  Without this file the system settings list does not show the app at all, so the only
  way to change its language was the whole-device locale. Android picks the user's
  system language when the app ships it, and falls back to res/values (English).

  Generated by tools/i18n_apply.py from res/values-*; do not hand-edit.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="it" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="pt" />
    <locale android:name="ru" />
    <locale android:name="sr" />
    <locale android:name="uk" />
    <locale android:name="zh-CN" />
    <locale android:name="zh-TW" />
</locale-config>

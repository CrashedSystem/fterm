# A font is served in chunks: MAX_FRAME caps one frame at 1 MiB and a real Iosevka build is
# larger than that, so the whole file cannot be a single frame.
FONT_CHUNK = 256 * 1024
FONT_MAX_BYTES = 32 * 1024 * 1024


def font_dirs():
    """Where the daemon looks for fonts to hand to the app.

    The point of this path is that it uses Termux's own reach: `curl` into ~/.fonts is one
    command, and the app cannot fetch a URL to storage it cannot write anyway. The shared
    Download folder is included because that is where a browser or a download manager drops
    a file, and ~/storage/downloads is the same directory seen through Termux's symlink.
    """
    env = os.environ.get("FTERM_FONT_DIRS")
    if env:
        return [os.path.expanduser(d) for d in env.split(":") if d]
    home = os.path.expanduser("~")
    prefix = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
    return [
        os.path.join(home, ".fonts"),
        os.path.join(home, ".local/share/fonts"),
        os.path.join(prefix, "share/fonts/TTF"),
        os.path.join(home, "storage/downloads/fonts"),
        "/sdcard/Download/fonts",
    ]


def font_scan():
    """Every .ttf/.otf the daemon can see, as (path, size), deduplicated.

    Deduplicated by real path: ~/storage/downloads/fonts and /sdcard/Download/fonts are the
    same directory twice, and listing one file twice makes the picker look broken.
    """
    out = []
    seen = set()
    for d in font_dirs():
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not name.lower().endswith((".ttf", ".otf")):
                continue
            path = os.path.join(d, name)
            try:
                if not os.path.isfile(path):
                    continue
                real = os.path.realpath(path)
                if real in seen:
                    continue
                size = os.path.getsize(real)
            except OSError:
                continue
            if size <= 0 or size > FONT_MAX_BYTES:
                continue
            seen.add(real)
            out.append((real, size))
    return out

# a client that has not sent a frame in this long is a ghost (a frozen app)
IDLE_TIMEOUT = 120


def default_shell():
    if SHELL:
        return SHELL
    for cand in ("/data/data/com.termux/files/usr/bin/bash",
                 "/data/data/com.termux/files/usr/bin/sh",
                 "/bin/bash"):
        if os.access(cand, os.X_OK):
            return cand
    return "/system/bin/sh"


# The app may name a shell and a starting directory; the daemon is the one that runs them,
# so the daemon is where "is this allowed" is decided. Without this the app could ask for
# /system/bin/anything, which is a privilege the terminal does not need.
SHELL_PREFIXES = (
    "/data/data/com.termux/files/usr/bin/",
    "/data/data/com.termux/files/usr/local/bin/",
    "/system/bin/sh",
    "/bin/",
    # On Debian and Ubuntu /bin is a symlink to /usr/bin, so every real path underneath one of
    # them starts with the other's name. Both are listed because the allowlist is checked
    # against the path that was asked for *and* the file it resolves to.
    "/usr/bin/",
)


def resolve_shell(requested):
    """The shell to exec: the requested one if it is an allowed absolute path, else None.

    Both the path the app asked for and the file it resolves to are tested against the
    allowlist, because they are not the same path on every system: /bin/sh is a script on
    Termux and a symlink to /usr/bin/dash on Debian. Checking only the resolved path refused
    /bin/sh on a runner and quietly fell back to bash - a profile that names a shell got a
    different one, and nothing said so.
    """
    if not requested:
        return None
    path = os.path.realpath(requested)
    if not os.path.isabs(path):
        return None
    asked = os.path.abspath(requested)

    def allowed(p):
        return any(p == pre or p.startswith(pre) for pre in SHELL_PREFIXES)

    if not (allowed(path) or allowed(asked)):
        return None
    if not (os.path.isfile(path) and os.access(path, os.X_OK)):
        return None
    return path


def resolve_cwd(requested):
    """The directory to start in: the requested one if it exists, else the home directory."""
    home = os.path.expanduser("~")
    if not requested:
        return home
    path = os.path.abspath(os.path.expanduser(requested))
    if os.path.isdir(path) and os.access(path, os.R_OK | os.X_OK):
        return path
    return home


# The variables Termux's own app shell hands to bash, and which most of /system/bin needs.
# `am` is the one that bites: it is `app_process` starting an APK's dex, and ART builds its
# boot class path from BOOTCLASSPATH. Without it `am` exits 0 having printed nothing, so
# termux-api commands look like they hang - they are waiting for a callback that the
# broadcast never sent. Measured by removing one variable at a time from a working shell:
# dropping any of these five breaks `am broadcast`; dropping ANDROID_DATA, ANDROID_ROOT or
# TERMUX_APP__* does not.
ANDROID_ENV = (
    "BOOTCLASSPATH",
    "DEX2OATBOOTCLASSPATH",
    "ANDROID_ART_ROOT",
    "ANDROID_I18N_ROOT",
    "ANDROID_TZDATA_ROOT",
    "ANDROID_DATA",
    "ANDROID_ROOT",
)

# Identity variables worth keeping for programs that ask "am I inside Termux".
TERMUX_ENV = (
    "TERMUX_VERSION",
    "TERMUX_MAIN_PACKAGE_FORMAT",
    "TERMUX_APK_RELEASE",
    "TERMUX_API_VERSION",
    "TERMUX_IS_DEBUGGABLE_BUILD",
    "TERMUX_APP_PID",
    "TERMUX__PREFIX",
    "TERMUX__HOME",
    "TERMUX__ROOTFS_DIR",
    "TERMUX_APP__DATA_DIR",
    "TERMUX_APP__LEGACY_DATA_DIR",
)

# Not inherited even when the daemon has it: these describe the daemon's own parent (an ssh
# session, the keeper, a debugger), and a shell that inherits SSH_CONNECTION believes it is
# an ssh login and skips the parts of .bashrc meant for a local terminal.
NEVER_INHERIT = (
    "SSH_CLIENT",
    "SSH_CONNECTION",
    "SSH_TTY",
    "SSH_AUTH_SOCK",
    "LD_PRELOAD",
    "LD_LIBRARY_PATH",
    "LD_INSERT_LIBRARIES",
    "TERM",
    "COLORTERM",
    "TERM_PROGRAM",
    "TERM_PROGRAM_VERSION",
    "FTERM_NOTIFY",
    "FTERM_PORT",
    "FTERM_RUNDIR",
    "FTERM_SHELL",
    "FTERM_HISTORY_BYTES",
    "FTERM_FONT_DIRS",
)


def _read_environ(pid):
    """One process's environment, or None if it is not readable."""
    try:
        with open("/proc/%s/environ" % pid, "rb") as f:
            raw = f.read()
    except (OSError, IOError):
        return None
    env = {}
    for item in raw.split(b"\0"):
        if b"=" in item:
            k, v = item.split(b"=", 1)
            if k:
                env[k.decode("utf-8", "replace")] = v.decode("utf-8", "replace")
    return env


def _bootclasspath_valid(value):
    """A boot class path from another device build lists jars that no longer exist."""
    if not value:
        return False
    parts = [p for p in value.split(":") if p]
    if not parts:
        return False
    return all(os.path.exists(p) for p in parts)


def _discover_android_env():
    """Find the ART variables by asking every process that has them.

    The daemon may be started by the keeper (which inherited the app shell's environment),
    by ssh, by cron, or by hand. Only the first of those has BOOTCLASSPATH. There is no
    system service to ask: /system/etc/classpaths/bootclasspath.pb lists only the framework
    jars and omits the ART core jars, so a shell built from it still dies. Reading a live
    process is the only accurate source. The result is cached, so this scan happens once.
    """
    own = _read_environ("self") or {}
    if _bootclasspath_valid(own.get("BOOTCLASSPATH")):
        found = {k: own[k] for k in ANDROID_ENV if k in own}
        write_cache(found)
        return found
    cached = _read_cache()
    if cached and _bootclasspath_valid(cached.get("BOOTCLASSPATH")):
        return cached
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        pids = []
    # Our own pid first, then everything else; the app's shell is usually near the end.
    pids.sort(key=lambda p: (p != str(os.getpid()), int(p)))
    for pid in pids:
        env = _read_environ(pid)
        if env and _bootclasspath_valid(env.get("BOOTCLASSPATH")):
            found = {k: env[k] for k in ANDROID_ENV if k in env}
            write_cache(found)
            return found
    return {}


def env_cache_path():
    return os.path.join(RUNDIR, "android.env")


def _read_cache():
    env = {}
    try:
        with open(env_cache_path()) as f:
            for line in f:
                line = line.strip()
                if line.startswith("export ") and "=" in line:
                    k, v = line[7:].split("=", 1)
                    env[k] = v.strip("\"'")
    except OSError:
        return {}
    return env


def write_cache(env):
    """Write the ART variables as shell syntax, so rish and other wrappers can source it."""
    ensure_rundir()
    dest = env_cache_path()
    tmp = dest + ".tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write("# Generated by ftermd. Source this to make app_process/am work.\n")
            for k in ANDROID_ENV:
                if k in env:
                    f.write("export %s='%s'\n" % (k, env[k].replace("'", "'\\''")))
            f.write("export CLASSPATH=\n")
        os.replace(tmp, dest)
    except OSError:
        pass


def shell_env():
    """The environment for a session's shell.

    Inheriting the daemon's whole environment would be wrong (see NEVER_INHERIT) and building
    a short list from scratch was worse: it left out the ART variables, and termux-api
    commands silently did nothing. So inherit, then curate - a shell may inherit it, but
    curate the list of what it may not.
    """
    env = {k: v for k, v in os.environ.items() if k not in NEVER_INHERIT}
    for k in TERMUX_ENV:
        if k in os.environ:
            env[k] = os.environ[k]
    env.update(_discover_android_env())
    # A pid borrowed from another process is meaningless once that process is gone.
    if "TERMUX_APP_PID" in env:
        try:
            os.kill(int(env["TERMUX_APP_PID"]), 0)
        except (OSError, ValueError):
            env.pop("TERMUX_APP_PID", None)
    env["HOME"] = os.path.expanduser("~")
    env["PWD"] = env["HOME"]
    env["PATH"] = os.environ.get(
        "PATH", "/data/data/com.termux/files/usr/bin:/system/bin:/usr/bin:/bin")
    env["PREFIX"] = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
    env["TMPDIR"] = os.environ.get("TMPDIR", "/data/data/com.termux/files/usr/tmp")
    env["LANG"] = os.environ.get("LANG", "en_US.UTF-8")
    env["SHELL"] = default_shell()
    env["TERM"] = "xterm-256color"
    env["COLORTERM"] = "truecolor"
    env["TERM_PROGRAM"] = "fterm"
    env["TERM_PROGRAM_VERSION"] = "0.2.0"
    env["FTERM_NOTIFY"] = "1"
    return env


def parse_open_strings(p, offset):
    """The two optional strings in an OPEN payload: (shell, cwd), either possibly "".

    Layout after the fixed six bytes is <u16 len><utf-8><u16 len><utf-8>. Both are optional
    together with the whole tail, so a truncation here means "use the defaults" rather than
    an error: an old app must still be able to open a session.
    """
    out = ["", ""]

    def take(off, slot):
        if off + 2 > len(p):
            return None
        (ln,) = struct.unpack_from("<H", p, off)
        off += 2
        if off + ln > len(p):
            return None
        out[slot] = p[off:off + ln].decode("utf-8", "replace")
        return off + ln

    off = take(offset, 0)
    if off is not None:
        take(off, 1)
    return out[0], out[1]


def ensure_rundir():
    os.makedirs(RUNDIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(RUNDIR, 0o700)
    except OSError:
        pass


def token_path():
    return os.path.join(RUNDIR, "token")


def read_token(create=True):
    p = token_path()
    try:
        with open(p, "r") as f:
            t = f.read().strip()
        if t:
            return t
    except FileNotFoundError:
        if not create:
            return None
    if not create:
        return None
    t = os.urandom(24).hex()
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(t)
    os.chmod(p, 0o600)
    return t


def write_token_file(name, value):
    p = os.path.join(RUNDIR, name)
    tmp = p + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(str(value))
    os.replace(tmp, p)


class Ring:
    """세션 출력의 최근 바이트. 재접속 시 화면 복원용."""

    def __init__(self, limit):
        self.limit = limit
        self.buf = bytearray()

    def add(self, data):
        self.buf += data
        if len(self.buf) > self.limit:
            # 바이트 경계가 아니라 UTF-8 시퀀스 경계에서 자른다. 아니면 복원된
            # 화면 첫 글자가 깨진다.
            cut = len(self.buf) - self.limit
            while cut < len(self.buf) and (self.buf[cut] & 0xC0) == 0x80:
                cut += 1
            del self.buf[:cut]

    def get(self):
        return bytes(self.buf)


class Modes:
    """세션의 터미널 모드 상태.

    프로그램은 시작할 때 한 번 DECSET으로 "마우스 이벤트를 보내라", "포커스 변화를
    알려라" 같은 선언을 하고 다시는 되풀이하지 않는다. 앱이 프로세스째 재생성되면
    에뮬레이터는 새로 만들어지고 ring(최근 256KiB)만 재생되므로, 그 선언이 ring 밖으로
    밀려난 경우 앱은 모드가 꺼진 상태로 시작한다. 셸은 여전히 켜져 있다고 믿으니
    스와이프가 히스토리 스크롤로 새고 탭이 TUI에 닿지 않는다 — 크기가 우연히 달라
    SIGWINCH가 갈 때만 프로그램이 다시 선언해서 살아난다.

    그래서 흘러가는 출력에서 이 선언들을 뽑아 마지막 상태를 들고 있다가, 재접속한
    클라이언트에게 ring보다 먼저 되돌려준다.
    """

    # 복원 순서. 화면을 지우는 alt screen(47/1047/1049)이 마지막이어야 그 위에 ring이
    # 다시 그려진다.
    RESTORE_ORDER = (7, 6, 25, 5, 1, 66, 2004, 1004,
                     1000, 1002, 1003, 1005, 1006, 1015,
                     47, 1047, 1049)

    # 화면을 스스로 그리는 프로그램이 떠 있다는 뜻의 모드. 재접속 시 다시 그리게 해야 한다.
    INTERACTIVE = (47, 1047, 1049, 1000, 1002, 1003)

    # 잘린 시퀀스를 다음 조각까지 들고 갈 수 있는 최대 길이. 실제 DECSET은
    # `ESC[?1006;1000h`처럼 짧고, 이보다 긴 파라미터 열이 끝나지 않고 이어지는 것은
    # 프로그램이 아니라 깨진 출력이다. 상한이 없으면 carry가 그 출력 전부를 붙들고
    # 자라서 메모리가 출력량을 따라간다(실측: 600바이트에서 계속 증가).
    MAX_PENDING = 64

    def __init__(self):
        self.state = {}
        self.carry = b""

    def feed(self, data):
        buf = self.carry + data
        self.carry = b""
        i = 0
        n = len(buf)
        while True:
            j = buf.find(b"\x1b[?", i)
            if j < 0:
                # 잘린 ESC 또는 ESC[ 는 다음 조각과 이어 붙인다.
                self.carry = b""
                for k in (2, 1):
                    if buf.endswith(b"\x1b[?"[:k]):
                        self.carry = buf[-k:]
                        break
                return
            k = start = j + 3
            while k < n and 0x30 <= buf[k] <= 0x3f:   # 파라미터 바이트
                k += 1
            if k >= n:
                # 아직 끝나지 않았다. 다음 조각과 이어 붙이되, 끝나지 않을 만큼 길면
                # 깨진 출력으로 보고 버린다 - 그 바이트들은 어차피 모드가 아니다.
                tail = buf[j:]
                self.carry = tail if len(tail) <= self.MAX_PENDING else b""
                return
            final = buf[k]
            if final in b"hl":
                for raw in buf[start:k].split(b";"):
                    try:
                        p = int(raw or b"0")
                    except ValueError:
                        continue
                    if p in self.RESTORE_ORDER:
                        self.state[p] = (final == ord("h"))
            i = k + 1

    def restore(self):
        """ring보다 먼저 보낼 바이트.켜져 있는 모드만."""
        return b"".join(b"\x1b[?%dh" % p for p in self.RESTORE_ORDER
                        if self.state.get(p))

    def interactive(self):
        return any(self.state.get(p) for p in self.INTERACTIVE)


class Session:
    def __init__(self, sid, cols, rows, shell, env, cwd=None):
        self.sid = sid
        self.cols = cols
        self.rows = rows
        self.ring = Ring(HISTORY_BYTES)
        self.modes = Modes()
        self.closed = False
        self.exit_code = None
        pid, fd = pty.fork()
        if pid == 0:
            # 자식: forkpty가 이미 setsid를 했다. 여기서는 exec만.
            try:
                os.chdir(resolve_cwd(cwd))
            except OSError:
                pass
            env = dict(env)
            # TERM_PROGRAM and friends are already set by shell_env(); they are repeated here
            # only so a caller that builds its own environment still gets them.
            env.setdefault("TERM", "xterm-256color")
            env.setdefault("COLORTERM", "truecolor")
            # Programs that can notify a terminal check this. fterm parses OSC 9 and OSC 777
            # itself, which is what lets a tool raise a real Android notification with no
            # helper process and no Termux:API.
            env.setdefault("TERM_PROGRAM", "fterm")
            env.setdefault("TERM_PROGRAM_VERSION", "0.2.0")
            env.setdefault("FTERM_NOTIFY", "1")
            env.setdefault("LANG", "en_US.UTF-8")
            try:
                os.execvpe(shell, [shell, "-l"], env)
            except Exception:
                os._exit(127)
        self.pid = pid
        self.fd = fd
        self.set_size(cols, rows)

    def set_size(self, cols, rows):
        self.cols = max(1, min(cols, 2000))
        self.rows = max(1, min(rows, 2000))
        self._apply_size(self.cols, self.rows)

    def redraw(self, delay=0.05):
        """Ask the program to repaint by delivering a SIGWINCH.

        The pty coalesces size changes, so setting the same size twice would be a no-op.
        Shrinking by one column and restoring it is two real changes, and it is what makes
        a full screen program - opencode, vim, less - redraw a screen the client lost.
        """
        if self.cols < 2:
            return
        self._apply_size(self.cols - 1, self.rows)
        time.sleep(delay)
        self._apply_size(self.cols, self.rows)

    def _apply_size(self, cols, rows):
        try:
            fcntl.ioctl(self.fd, termios.TIOCSWINSZ,
                        struct.pack("HHHH", rows, cols, 0, 0))
        except OSError:
            pass

    def write(self, data):
        try:
            os.write(self.fd, data)
        except OSError:
            pass

    def read(self):
        try:
            return os.read(self.fd, 65536)
        except OSError as e:
            if e.errno in (errno.EIO, errno.EBADF):
                return b""
            raise

    def close(self, kill=True):
        if self.closed:
            return
        self.closed = True
        if kill and self.pid > 0:
            for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(self.pid, sig)
                except OSError:
                    try:
                        os.kill(self.pid, sig)
                    except OSError:
                        break
                time.sleep(0.02)
        try:
            os.close(self.fd)
        except OSError:
            pass


class Client:
    def __init__(self, sock, addr):
        self.sock = sock
        self.addr = addr
        self.inbuf = bytearray()
        self.authed = False
        self.alive = True
        self.outbuf = bytearray()
        self.pending_sync = 0
        self.attached = set()
        self.last_seen = time.time()

    def send(self, data):
        if not self.alive:
            return
        self.outbuf += data
        self.flush()

    def flush(self):
        while self.outbuf and self.alive:
            try:
                n = self.sock.send(self.outbuf[:65536])
            except (BlockingIOError, InterruptedError):
                return
            except OSError:
                self.alive = False
                return
            if n <= 0:
                self.alive = False
                return
            del self.outbuf[:n]

    def frame(self, typ, payload=b""):
        return struct.pack("<BI", typ, len(payload)) + payload

    def error(self, code, msg):
        b = msg.encode("utf-8", "replace")
        self.send(self.frame(S_ERROR, struct.pack("<BH", code, len(b)) + b))


def fetch_font(url):
    """Download one font into ~/.fonts and return its path, or raise ValueError.

    Done here rather than in the app because this is the side with a network stack that can
    write a font somewhere the app can read. The app has neither: no URL client of its own,
    and no storage the download could land in that it is allowed to open.
    """
    import urllib.request

    url = (url or "").strip()
    if not url.startswith(("http://", "https://")):
        raise ValueError("http:// 또는 https:// 주소만 받습니다")
    name = url.split("?")[0].rstrip("/").rsplit("/", 1)[-1]
    if not name.lower().endswith((".ttf", ".otf")):
        raise ValueError("주소가 .ttf/.otf로 끝나지 않습니다: %s" % name)
    name = "".join(c if (c.isalnum() or c in "._-") else "_" for c in name)
    dest_dir = os.path.join(os.path.expanduser("~"), ".fonts")
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, name)
    tmp = dest + ".part"
    try:
        with urllib.request.urlopen(url, timeout=30) as r, open(tmp, "wb") as f:
            size = 0
            while True:
                block = r.read(65536)
                if not block:
                    break
                f.write(block)
                size += len(block)
                if size > FONT_MAX_BYTES:
                    raise ValueError("파일이 너무 큽니다 (32MB 초과)")
        if size == 0:
            raise ValueError("빈 파일입니다")
        os.replace(tmp, dest)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return dest


def u16(v):
    return struct.pack("<H", v)


def u32(v):
    return struct.pack("<I", v)


class Daemon:
    def __init__(self):
        ensure_rundir()
        self.token = read_token()
        self.sessions = {}
        self.clients = []
        self.shell = default_shell()
        self.srv = None
        self.base_env = shell_env()

    # ---------- lifecycle ----------

    def listen(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("127.0.0.1", PORT))
        s.listen(8)
        s.setblocking(False)
        self.srv = s
        write_token_file("ftermd.pid", os.getpid())
        print("ftermd %s listening on 127.0.0.1:%d (shell %s)"
              % (PROTO_VERSION, PORT, self.shell), flush=True)

    def stop(self, signum=None, frame=None):
        for c in list(self.clients):
            c.alive = False
            try:
                c.sock.close()
            except OSError:
                pass
        for s in list(self.sessions.values()):
            s.close()
        try:
            if self.srv:
                self.srv.close()
        except OSError:
            pass
        try:
            os.unlink(os.path.join(RUNDIR, "ftermd.pid"))
        except OSError:
            pass
        sys.exit(0)

    # ---------- main loop ----------

    def run(self):
        self.listen()
        signal.signal(signal.SIGTERM, self.stop)
        signal.signal(signal.SIGINT, self.stop)
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        # Survive the terminal that launched us: a daemon started with plain nohup from a
        # Termux shell still receives SIGHUP when that shell closes, and the default action
        # for SIGHUP is terminate. That was the measured "ftermd died while I was away"
        # (process 23510, parent = the closed shell). Ignore it; the keeper's setsid makes
        # this redundant there, but a hand-started daemon deserves the same immunity.
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        while True:
            # Drop idle clients BEFORE building the fd set. The previous order put a socket
            # into rfds and then closed it, so select() received -1 and the daemon died with
            # "file descriptor cannot be a negative integer" - a crash that also took every
            # live shell with it, which is what "the terminal dies when idle" looked like.
            self.drop_idle()

            rfds = [self.srv]
            for c in self.clients:
                if c.alive:
                    rfds.append(c.sock)
            for s in self.sessions.values():
                if not s.closed and s.fd >= 0:
                    rfds.append(s.fd)
            try:
                r, _, _ = select.select(rfds, [], [], 1.0)
            except InterruptedError:
                continue
            except (OSError, ValueError) as e:
                # A closed fd or a signal; neither is a reason to lose every session.
                self.log("select error: %s" % e)
                time.sleep(0.05)
                continue

            for fd in r:
                if fd is self.srv:
                    self.accept()
                elif isinstance(fd, socket.socket):
                    cl = self.clients_by_sock(fd)
                    if cl:
                        self.read_client(cl)
                else:
                    self.read_pty(fd)

            self.reap()

    def clients_by_sock(self, sock):
        for c in self.clients:
            if c.sock is sock:
                return c
        return None

    def accept(self):
        try:
            s, addr = self.srv.accept()
        except OSError:
            return
        s.setblocking(False)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.clients.append(Client(s, addr))

    def drop(self, cl):
        self.log("client %s dropped (attached=%s)" % (cl.addr, sorted(cl.attached)))
        cl.alive = False
        try:
            cl.sock.close()
        except OSError:
            pass
        if cl in self.clients:
            self.clients.remove(cl)

    def read_client(self, cl):
        try:
            data = cl.sock.recv(65536)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            self.drop(cl)
            return
        if not data:
            self.drop(cl)
            return
        cl.last_seen = time.time()
        cl.inbuf += data
        self.parse(cl)

    def parse(self, cl):
        while len(cl.inbuf) >= 5:
            typ = cl.inbuf[0]
            (length,) = struct.unpack_from("<I", cl.inbuf, 1)
            if length > MAX_FRAME:
                cl.error(E_BAD_FRAME, "frame too large")
                self.drop(cl)
                return
            if len(cl.inbuf) < 5 + length:
                return
            payload = bytes(cl.inbuf[5:5 + length])
            del cl.inbuf[:5 + length]
            self.handle(cl, typ, payload)

    def log(self, msg):
        # stderr only; the daemon's stdout carries the one-line startup banner.
        sys.stderr.write("[ftermd %s] %s\n" % (time.strftime("%H:%M:%S"), msg))
        sys.stderr.flush()

    def drop_idle(self):
        """Drop clients that have not sent anything for a long time.

        A frozen app keeps its TCP connection open without sending a byte. Holding its
        session is harmless, but the client list would grow with ghosts and the next real
        client's frames would compete with them for the socket budget.
        """
        now = time.time()
        for c in list(self.clients):
            if now - c.last_seen > IDLE_TIMEOUT:
                self.log("client %s idle for %ds, dropped" % (c.addr, IDLE_TIMEOUT))
                self.drop(c)

    def font_list_payload(self):
        fonts = font_scan()
        out = bytearray(u16(len(fonts)))
        for path, size in fonts:
            name = os.path.basename(path).encode("utf-8", "replace")
            p = path.encode("utf-8", "replace")
            out += u16(len(name)) + name + u32(size) + u16(len(p)) + p
        return bytes(out)

    def send_font(self, cl, path):
        """Stream one scanned font. Only a path the scan itself returned is served.

        The request carries a path, so without this check the frame would be a way to read
        any file the daemon uid can open. Rescanning and matching the real path keeps the
        surface at "fonts that are already visible in the picker".
        """
        wanted = None
        try:
            real = os.path.realpath(path)
        except OSError:
            real = path
        for p, _ in font_scan():
            if p == real:
                wanted = p
                break
        if wanted is None:
            cl.error(E_BAD_FRAME, "font not found")
            return
        try:
            with open(wanted, "rb") as f:
                data = f.read(FONT_MAX_BYTES + 1)
        except OSError as e:
            cl.error(E_BAD_FRAME, "font unreadable: %s" % e)
            return
        if len(data) > FONT_MAX_BYTES:
            cl.error(E_BAD_FRAME, "font too large")
            return
        total = len(data)
        pb = wanted.encode("utf-8", "replace")
        off = 0
        while off < total:
            chunk = data[off:off + FONT_CHUNK]
            cl.send(cl.frame(S_FONT_DATA,
                             u32(total) + u32(off) + u16(len(pb)) + pb + chunk))
            off += len(chunk)
            # A 1 MiB font is four frames; flushing after each keeps the client's read loop
            # from starving behind the daemon's select() turn.
            cl.flush()
        self.log("font sent %s (%d bytes)" % (os.path.basename(wanted), total))

    def handle(self, cl, typ, p):
        if typ == C_HELLO:
            if len(p) < 1:
                cl.error(E_BAD_FRAME, "short hello")
                self.drop(cl)
                return
            proto = p[0]
            tokl = struct.unpack_from("<H", p, 1)[0] if len(p) >= 3 else 0
            tok = p[3:3 + tokl].decode("utf-8", "replace") if len(p) >= 3 + tokl else ""
            if proto != PROTO_VERSION:
                cl.error(E_BAD_PROTO, "protocol %d != %d" % (proto, PROTO_VERSION))
                self.drop(cl)
                return
            if tok != self.token:
                cl.error(E_BAD_TOKEN, "bad token")
                self.drop(cl)
                return
            cl.authed = True
            self.log("hello ok from %s" % (cl.addr,))
            cl.send(cl.frame(S_HELLO_OK, bytes([PROTO_VERSION])))
            return

        if not cl.authed:
            cl.error(E_BAD_TOKEN, "hello first")
            self.drop(cl)
            return

        if typ == C_PING:
            cl.send(cl.frame(S_PONG, p))
        elif typ == C_FONT_LIST:
            cl.send(cl.frame(S_FONT_LIST, self.font_list_payload()))
        elif typ == C_FONT_FETCH:
            if len(p) < 2:
                cl.error(E_BAD_FRAME, "short fetch request")
                return
            (n,) = struct.unpack_from("<H", p, 0)
            url = p[2:2 + n].decode("utf-8", "replace")
            try:
                dest = fetch_font(url)
            except Exception as e:
                self.log("font fetch failed: %s (%s)" % (url, e))
                msg = ("%s" % e).encode("utf-8", "replace")
                cl.send(cl.frame(S_FONT_FETCHED, u16(0) + u16(len(msg)) + msg))
                return
            self.log("font fetched %s" % dest)
            pb = dest.encode("utf-8", "replace")
            cl.send(cl.frame(S_FONT_FETCHED, u16(len(pb)) + pb))
        elif typ == C_FONT_GET:
            if len(p) < 2:
                cl.error(E_BAD_FRAME, "short font request")
                return
            (n,) = struct.unpack_from("<H", p, 0)
            path = p[2:2 + n].decode("utf-8", "replace")
            self.send_font(cl, path)
        elif typ == C_OPEN:
            if len(p) < 6:
                cl.error(E_BAD_FRAME, "short open")
                return
            sid, cols, rows = struct.unpack_from("<HHH", p, 0)
            # Trailing strings are optional: a client that sends six bytes gets the daemon's
            # default shell and the home directory, which is exactly what older builds did.
            shell_req, cwd_req = parse_open_strings(p, 6)
            if sid in self.sessions:
                sess = self.sessions[sid]
                sess.set_size(cols, rows)
            else:
                if len(self.sessions) >= MAX_SESSIONS:
                    cl.error(E_TOO_MANY, "too many sessions")
                    return
                shell = resolve_shell(shell_req) or self.shell
                try:
                    sess = Session(sid, cols, rows, shell, self.base_env, cwd_req)
                except Exception as e:
                    cl.error(E_SPAWN, "spawn failed: %s" % e)
                    return
                self.sessions[sid] = sess
            cl.attached.add(sid)
            self.log("open sid=%d cols=%d rows=%d pid=%d (clients=%d)"
                     % (sid, cols, rows, sess.pid, len(self.clients)))
            cl.send(cl.frame(S_OPENED, struct.pack("<Hi", sid, sess.pid)))
            # The modes go out before the ring: they are a property of the program that is
            # still running, and the screen below may be its redraw of them.
            modes = sess.modes.restore()
            if modes:
                cl.send(cl.frame(S_OUTPUT, struct.pack("<H", sid)
                                 + struct.pack("<I", len(modes)) + modes))
            ring = sess.ring.get()
            if ring:
                cl.send(cl.frame(S_REPLAY, struct.pack("<H", sid) + ring))
            if sess.modes.interactive():
                # A full screen program owns the screen and only paints when *it* decides
                # to. Its last frame is in the ring, but the cursor and the row it thinks
                # it is on are not. Asking for a repaint is what makes a reattached TUI
                # come back usable instead of merely looking right.
                sess.redraw()
        elif typ == C_CLOSE:
            if len(p) < 2:
                return
            (sid,) = struct.unpack_from("<H", p, 0)
            sess = self.sessions.pop(sid, None)
            self.log("close sid=%d%s" % (sid, "" if sess else " (no such session)"))
            if sess:
                sess.close(kill=True)
            for c in self.clients:
                c.attached.discard(sid)
        elif typ == C_INPUT:
            if len(p) < 6:
                return
            sid = struct.unpack_from("<H", p, 0)[0]
            (l,) = struct.unpack_from("<I", p, 2)
            data = p[6:6 + l]
            sess = self.sessions.get(sid)
            if sess and not sess.closed:
                self.log("input sid=%d %d bytes %r" % (sid, len(data), data[:40]))
                sess.write(data)
        elif typ == C_RESIZE:
            if len(p) < 6:
                return
            sid, cols, rows = struct.unpack_from("<HHH", p, 0)
            sess = self.sessions.get(sid)
            if sess and not sess.closed:
                sess.set_size(cols, rows)
        elif typ == C_SYNC:
            # 살아있는 세션 목록을 알려준다. 앱이 재접속 후 정리할 때 쓴다.
            ids = [sid for sid, s in self.sessions.items() if not s.closed]
            cl.send(cl.frame(S_SYNCED,
                             struct.pack("<H", len(ids)) +
                             b"".join(struct.pack("<H", i) for i in ids)))
        else:
            cl.error(E_BAD_FRAME, "unknown type %d" % typ)

    def read_pty(self, fd):
        for sid, s in list(self.sessions.items()):
            if s.fd != fd:
                continue
            data = s.read()
            if not data:
                # 셸 종료
                code = self.wait_exit(s)
                s.closed = True
                for c in self.clients:
                    if sid in c.attached:
                        c.send(c.frame(S_EXIT, struct.pack("<Hi", sid, code)))
                self.sessions.pop(sid, None)
                return
            s.ring.add(data)
            s.modes.feed(data)
            frame = struct.pack("<H", sid) + struct.pack("<I", len(data)) + data
            for c in self.clients:
                if sid in c.attached:
                    c.send(c.frame(S_OUTPUT, frame))
            return

    def wait_exit(self, s):
        try:
            pid, status = os.waitpid(s.pid, os.WNOHANG)
        except OSError:
            return -1
        return os.waitstatus_to_exitcode(status) if pid else -1

    def reap(self):
        for c in list(self.clients):
            if not c.alive:
                self.clients.remove(c)
        for sid, s in list(self.sessions.items()):
            if s.closed:
                continue
            try:
                pid, status = os.waitpid(s.pid, os.WNOHANG)
            except OSError:
                continue
            if pid:
                code = os.waitstatus_to_exitcode(status)
                s.closed = True
                for c in self.clients:
                    if sid in c.attached:
                        c.send(c.frame(S_EXIT, struct.pack("<Hi", sid, code)))
                try:
                    os.close(s.fd)
                except OSError:
                    pass
                self.sessions.pop(sid, None)


# ---------- CLI ----------

def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def cmd_start():
    # 중복 실행 방지
    pidf = os.path.join(RUNDIR, "ftermd.pid")
    try:
        with open(pidf) as f:
            old = int(f.read().strip() or 0)
        if old and pid_alive(old):
            print("ftermd already running (pid %d)" % old)
            return 1
    except (OSError, ValueError):
        pass
    d = Daemon()
    d.run()
    return 0


def cmd_stop():
    pidf = os.path.join(RUNDIR, "ftermd.pid")
    try:
        with open(pidf) as f:
            pid = int(f.read().strip() or 0)
    except (OSError, ValueError):
        print("no pidfile")
        return 1
    if not pid:
        return 1
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as e:
        print("kill failed: %s" % e)
        return 1
    for _ in range(100):
        if not pid_alive(pid):
            print("stopped")
            return 0
        time.sleep(0.05)
    print("still running (pid %d)" % pid)
    return 1


def cmd_status():
    pidf = os.path.join(RUNDIR, "ftermd.pid")
    pid = 0
    try:
        with open(pidf) as f:
            pid = int(f.read().strip() or 0)
    except (OSError, ValueError):
        pass
    alive = pid_alive(pid) if pid else False
    reachable = False
    try:
        s = socket.create_connection(("127.0.0.1", PORT), 1.0)
        s.close()
        reachable = True
    except OSError:
        pass
    print(json.dumps({"pid": pid, "alive": alive, "port": PORT,
                      "reachable": reachable, "shell": default_shell(),
                      "rundir": RUNDIR, "token_file": token_path()},
                     ensure_ascii=False))
    return 0 if (alive and reachable) else 2


def cmd_token():
    print(read_token())
    return 0


def cmd_fonts():
    """List what the daemon would offer the app, as tab-separated size and path.

    The same scan the socket uses, so the CLI and the picker cannot disagree about what is
    installed. Tab-separated because a path may contain spaces and this is read by scripts.
    """
    fonts = font_scan()
    for path, size in fonts:
        print("%d\t%s" % (size, path))
    return 0 if fonts else 1


def cmd_font(url):
    """Download a font into ~/.fonts, then print where it landed.

    This is the bootstrap for the app's "URL로 받기": a user who has never opened the app can
    put a font somewhere the app can see with one command, and a user whose app is stuck gets
    the same command as a fallback. The rules - http(s) only, .ttf/.otf only, 32 MB cap - live
    in fetch_font, so the CLI cannot accept something the socket would refuse.
    """
    if not url:
        print("사용법: ftermd font <url>", file=sys.stderr)
        return 2
    try:
        dest = fetch_font(url)
    except Exception as e:
        print("ftermd font: %s" % e, file=sys.stderr)
        return 1
    print(dest)
    return 0


def cmd_env():
    """Print the ART variables as shell syntax, for wrappers such as rish2 to source."""
    env = _discover_android_env()
    if not _bootclasspath_valid(env.get("BOOTCLASSPATH")):
        print("ftermd env: could not find BOOTCLASSPATH in any process", file=sys.stderr)
        return 1
    for k in ANDROID_ENV:
        if k in env:
            print("export %s='%s'" % (k, env[k].replace("'", "'\\''")))
    return 0


def cmd_reset_token():
    p = token_path()
    try:
        os.unlink(p)
    except OSError:
        pass
    print(read_token())
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd = argv[1]
    if cmd == "start":
        return cmd_start()
    if cmd == "stop":
        return cmd_stop()
    if cmd == "status":
        return cmd_status()
    if cmd == "token":
        return cmd_token()
    if cmd == "reset-token":
        return cmd_reset_token()
    if cmd == "fonts":
        return cmd_fonts()
    if cmd == "font":
        return cmd_font(argv[2] if len(argv) > 2 else "")
    if cmd == "env":
        return cmd_env()
    print("ftermd: unknown command %s" % cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.crashedsystem.fterm"
    android:versionCode="12"
    android:versionName="0.3.0">

    <!-- Android 8.0 (API 26) is the floor: the vendored terminal view needs
         View#getTextSelectionActionMode-era behaviour and adaptive icons. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse, not dataSync: Android 15 caps a dataSync foreground service at six hours
         per day, and this service exists to stay up for as long as a shell is attached. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Clipboard images arrive as content:// URIs owned by the gallery/MediaStore.
         Reading one requires this permission (API 33+) - without it the paste of a
         screenshot decodes to nothing, which is the "image paste does not work" report. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- The terminal bell's default is a short vibration; without this it is a silent no-op. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="io.github.crashedsystem.fterm.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize|density|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the process out of Android's freezer while a shell is attached. Without it
             a backgrounded app is SIGSTOPped (measured: isFrozen=true) and its socket dies.

             The type is specialUse rather than dataSync: Android 15 lets a dataSync service run
             for six hours in any 24, then stops it, and "the terminal is up while a shell is
             attached" is exactly the kind of long-lived session that limit was not written for.
             specialUse has no such clock, and it is the declared type Android asks for when no
             other type fits. -->
        <service
            android:name="io.github.crashedsystem.fterm.TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal session: holds the socket to the PTY daemon so a shell survives while the app is in the background" />
        </service>

        <!-- The script-facing background door: copy a picture in and repaint, without
             rebuilding the APK. See BackgroundReceiver for the am command and the path
             checks that keep it from reading anything the app could not already see. -->
        <receiver
            android:name="io.github.crashedsystem.fterm.BackgroundReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.crashedsystem.fterm.action.APPLY_BACKGROUND" />
                <action android:name="io.github.crashedsystem.fterm.action.CLEAR_BACKGROUND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
